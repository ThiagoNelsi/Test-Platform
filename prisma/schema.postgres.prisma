generator client {
  provider = "prisma-client-js"
  output   = "./generated/postgres"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_POSTGRES")
}

model User {
  id            Int          @id @default(autoincrement())
  createdAt     DateTime     @default(now()) @db.Timestamptz(0)
  name          String
  email         String       @unique
  password      String
  posts         Post[]
  ownedClasses  Classroom[]  @relation("Owner")
  classrooms    Classroom[]  @relation("Student")
  comments      Comment[]
  questions     Question[]
  testInstances TestInstance[]
  tags          Tag[]
}

model Classroom {
  id        Int     @id @default(autoincrement())
  createdAt DateTime @default(now()) @db.Timestamptz(0)
  name      String
  code      String  @unique
  owner     User    @relation("Owner", fields: [ownerId], references: [id])
  ownerId   Int
  posts     Post[]
  tests     Test[]
  students  User[]  @relation("Student")

  @@unique([ownerId, name])
}

model Post {
  id          Int       @id @default(autoincrement())
  date        DateTime  @default(now()) @db.Timestamptz(0)
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  classroomId Int
  author      User      @relation(fields: [authorId], references: [id])
  authorId    Int
  comments    Comment[]
}

model Comment {
  id          Int       @id @default(autoincrement())
  date        DateTime  @default(now()) @db.Timestamptz(0)
  post        Post      @relation(fields: [postId], references: [id])
  postId      Int
  author      User      @relation(fields: [authorId], references: [id])
  authorId    Int
  text        String
  answers     Comment[] @relation("CommentAnswers")
  parent      Comment?  @relation("CommentAnswers", fields: [parentId], references: [id])
  parentId    Int?
}

model Question {
  id            Int       @id @default(autoincrement())
  createdAt     DateTime  @default(now()) @db.Timestamptz(0)
  type          String
  author        User      @relation(fields: [authorId], references: [id])
  authorId      Int
  level         Int?
  tags          Tag[]
}

model Tag {
  id          Int       @id @default(autoincrement())
  name        String
  color       Int
  questions   Question[]
  user        User     @relation(fields: [userId], references: [id])
  userId      Int

  @@unique([userId, name])
}

model Test {
  id          Int            @id @default(autoincrement())
  createdAt   DateTime       @default(now()) @db.Timestamptz(0)
  name        String
  classroom   Classroom      @relation(fields: [classroomId], references: [id])
  classroomId Int
  dueDate     DateTime?      @db.Timestamptz(0)
  timer       Int?
  value       Int            @default(10)
  instances   TestInstance[]
}

model TestInstance {
  id          Int       @id             @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  test        Test      @relation(fields: [testId], references: [id])
  testId      Int
  startTime   DateTime?  @default(now()) @db.Timestamptz(0)
  finishTime  DateTime?  @db.Timestamptz(0)
  score       Float?
}
