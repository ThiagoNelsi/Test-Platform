generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_POSTGRES")
}

model User {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  password     String
  createdAt    DateTime     @default(now()) @db.Timestamptz(0)
  ownedClasses Classroom[]  @relation("Owner")
  comments     Comment[]
  posts        Post[]
  questions    Question[]
  submissions  Submission[]
  tags         Tag[]
  tests        Test[]
  classrooms   Classroom[]  @relation("Student")
  resources    Resource[]
}

model Classroom {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  ownerId   Int
  createdAt DateTime @default(now()) @db.Timestamptz(0)
  owner     User     @relation("Owner", fields: [ownerId], references: [id])
  posts     Post[]
  tests     Test[]
  students  User[]   @relation("Student")

  @@unique([ownerId, name])
}

model Post {
  id          Int       @id @default(autoincrement())
  date        DateTime  @default(now()) @db.Timestamptz(0)
  classroomId Int
  authorId    Int
  comments    Comment[]
  author      User      @relation(fields: [authorId], references: [id])
  classroom   Classroom @relation(fields: [classroomId], references: [id])
}

model Comment {
  id       Int       @id @default(autoincrement())
  date     DateTime  @default(now()) @db.Timestamptz(0)
  postId   Int
  authorId Int
  text     String
  parentId Int?
  author   User      @relation(fields: [authorId], references: [id])
  parent   Comment?  @relation("CommentAnswers", fields: [parentId], references: [id])
  answers  Comment[] @relation("CommentAnswers")
  post     Post      @relation(fields: [postId], references: [id])
}

model Question {
  id                 Int        @id @default(autoincrement())
  createdAt          DateTime   @default(now()) @db.Timestamptz(0)
  updatedAt          DateTime   @default(now()) @db.Timestamptz(0)
  deletedAt          DateTime?  @db.Timestamptz(0)
  type               String
  authorId           Int
  level              Int?
  content            Json       @default("{}")
  originalQuestionId Int?
  version            Int        @default(1)
  subjects           String[]
  author             User       @relation(fields: [authorId], references: [id])
  originalQuestion   Question?  @relation("QuestionSnapshots", fields: [originalQuestionId], references: [id])
  snapshots          Question[] @relation("QuestionSnapshots")
  tags               Tag[]      @relation("QuestionToTag")
  source             String?

  @@unique([id, version])
  @@unique([originalQuestionId, version])
}

model Tag {
  id        Int        @id @default(autoincrement())
  name      String
  color     Int
  userId    Int
  user      User       @relation(fields: [userId], references: [id])
  questions Question[] @relation("QuestionToTag")

  @@unique([userId, name])
}

model Test {
  id          Int          @id @default(autoincrement())
  name        String       @default("Sem título")
  classroomId Int?
  dueDate     DateTime?    @db.Timestamptz(0)
  timer       Int?
  value       Int          @default(10)
  createdAt   DateTime     @default(now()) @db.Timestamptz(0)
  description String?
  publishDate DateTime?    @db.Timestamptz(0)
  status      String       @default("draft")
  sections    Json         @default("[]")
  authorId    Int
  modifiedAt  DateTime     @default(now()) @db.Timestamptz(0)
  deletedAt   DateTime?    @db.Timestamptz(0)
  submissions Submission[]
  author      User         @relation(fields: [authorId], references: [id])
  classroom   Classroom?   @relation(fields: [classroomId], references: [id])
}

model Submission {
  id         Int       @id @default(autoincrement())
  userId     Int
  testId     Int
  startTime  DateTime  @default(now()) @db.Timestamptz(0)
  finishTime DateTime? @db.Timestamptz(0)
  score      Float?
  answers    Json      @default("{}")
  sections   Json
  test       Test      @relation(fields: [testId], references: [id])
  user       User      @relation(fields: [userId], references: [id])
}

enum ResourceStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

model Resource {
  id          Int       @id @default(autoincrement())
  filename    String
  fileType    String
  tags        String[]
  objectKey   String
  jobId       String?
  status      ResourceStatus @default(UPLOADED)
  ownerId     Int
  owner       User      @relation(fields: [ownerId], references: [id])
  createdAt   DateTime  @default(now()) @db.Timestamptz(0)
  processedAt DateTime? @db.Timestamptz(0)
  deletedAt   DateTime? @db.Timestamptz(0)
}

model RepositoryQuestion {
  id                  Int       @id @default(autoincrement())
  createdAt           DateTime  @default(now()) @db.Timestamptz(0)
  deletedAt           DateTime? @db.Timestamptz(0)
  type                String
  level               Int?
  content             Json      @default("{}")
  subjects            String[]
  tags                String[]
  source              String?
}
