generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int          @id @default(autoincrement())
  name          String
  email         String       @unique
  password      String
  posts         Post[]
  classrooms    Classroom[]
  comments      Comment[]
  questionBanks QuestionBank[]
  questions     Question[]
  testInstances TestInstance[]
}

model Classroom {
  id      Int     @id @default(autoincrement())
  name    String
  code    String
  owner   User    @relation(fields: [ownerId], references: [id])
  ownerId Int
  posts   Post[]
  tests   Test[]
}

model Post {
  id          Int       @id @default(autoincrement())
  date        DateTime  @default(now()) @db.Timestamptz(0)
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  classroomId Int
  author      User      @relation(fields: [authorId], references: [id])
  authorId    Int
  comments    Comment[]
}

model Comment {
  id          Int       @id @default(autoincrement())
  date        DateTime  @default(now()) @db.Timestamptz(0)
  post        Post      @relation(fields: [postId], references: [id])
  postId      Int
  author      User      @relation(fields: [authorId], references: [id])
  authorId    Int
  text        String
  answers     Comment[] @relation("CommentAnswers")
  parent      Comment?  @relation("CommentAnswers", fields: [parentId], references: [id])
  parentId    Int?
}

model QuestionBank {
  id          Int     @id @default(autoincrement())
  owner       User    @relation(fields: [ownerId], references: [id])
  ownerId     Int
  name        String
  tags        String[]
  description String
  questions   Question[]

  @@unique([ownerId, name])
}

model Question {
  id            Int       @id @default(autoincrement())
  type          String
  author        User      @relation(fields: [authorId], references: [id])
  authorId      Int
  level         Int
  tags          String[]
  questionBanks QuestionBank[]
}

model Test {
  id          Int            @id @default(autoincrement())
  name        String
  classroom   Classroom      @relation(fields: [classroomId], references: [id])
  classroomId Int
  dueDate     DateTime       @db.Timestamptz(0)
  timer       Int
  value       Int
  instances   TestInstance[]
}

model TestInstance {
  id          Int       @id             @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  test        Test      @relation(fields: [testId], references: [id])
  testId      Int
  startTime   DateTime  @default(now()) @db.Timestamptz(0)
  finishTime  DateTime  @db.Timestamptz(0)
  score       Float
}
