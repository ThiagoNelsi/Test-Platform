{
  "name": "test-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm run generate && pnpm run dev:apps",
    "dev:apps": "pnpm --parallel --filter api --filter test-platform-frontend run dev",
    "dev:api": "pnpm --filter api run dev",
    "dev:frontend": "pnpm --filter test-platform-frontend run dev",
    "build:contracts": "pnpm --filter api-contracts run build",
    "build:api": "pnpm --filter api run build",
    "build:frontend": "pnpm --filter test-platform-frontend run build",
    "build": "pnpm run generate && pnpm run build:api && pnpm run build:frontend",
    "test:api": "pnpm --filter api run test",
    "test:frontend": "pnpm --filter test-platform-frontend run test",
    "test": "pnpm run generate && pnpm run test:api && pnpm run test:frontend",
    "typecheck:contracts": "pnpm --filter api-contracts run typecheck",
    "typecheck:api": "pnpm --filter api run typecheck",
    "typecheck:frontend": "pnpm --filter test-platform-frontend run type-check",
    "typecheck": "pnpm run generate && pnpm run typecheck:contracts && pnpm run typecheck:api && pnpm run typecheck:frontend",
    "lint": "pnpm --filter test-platform-frontend run lint",
    "generate": "pnpm run build:contracts && pnpm run prisma:generate",
    "prisma:generate": "pnpm --filter api run prisma:generate"
  }
}
