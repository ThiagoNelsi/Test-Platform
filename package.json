{
  "name": "test-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm run generate && pnpm run dev:apps",
    "dev:apps": "pnpm --parallel --filter api --filter test-platform-frontend run dev",
    "dev:api": "pnpm --filter api run dev",
    "dev:frontend": "pnpm --filter test-platform-frontend run dev",
    "build:contracts": "pnpm --filter api-contracts run build",
    "build:api": "pnpm --filter api run build",
    "build:frontend": "pnpm --filter test-platform-frontend run build",
    "build": "pnpm run generate && pnpm run build:api && pnpm run build:frontend",
    "test:api": "pnpm --filter api run test",
    "benchmark:retrieval": "pnpm --filter api run benchmark:retrieval",
    "test:frontend": "pnpm --filter test-platform-frontend run test",
    "test:ingestion": "pnpm --filter document-ingestion run test",
    "test": "pnpm run generate && pnpm run test:api && pnpm run test:frontend && pnpm run test:ingestion",
    "typecheck:contracts": "pnpm --filter api-contracts run typecheck",
    "typecheck:api": "pnpm --filter api run typecheck",
    "typecheck:frontend": "pnpm --filter test-platform-frontend run type-check",
    "typecheck:ingestion": "pnpm --filter document-ingestion run typecheck",
    "typecheck": "pnpm run generate && pnpm run typecheck:contracts && pnpm run typecheck:api && pnpm run typecheck:frontend && pnpm run typecheck:ingestion",
    "lint:backend": "eslint api api-contracts document-ingestion",
    "lint:frontend": "pnpm --filter test-platform-frontend run lint",
    "lint": "pnpm run lint:backend && pnpm run lint:frontend",
    "generate": "pnpm run build:contracts && pnpm run prisma:generate",
    "prisma:generate": "pnpm --filter api run prisma:generate",
    "migrate:app": "pnpm --filter api run migrate:app",
    "baseline:embeddings": "pnpm --filter api run baseline:embeddings",
    "migrate:embeddings": "pnpm --filter api run migrate:embeddings"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^9.39.5",
    "globals": "^14.0.0"
  }
}
